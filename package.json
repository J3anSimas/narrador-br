{
  "name": "narrador-br",
  "version": "1.0.0",
  "description": "Separa um texto em parágrafos e o transforma em áudio com a OpenAI (CLI e app desktop).",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "paragrafos": "dist/cli/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:desktop": "npm run build && node scripts/buildDesktopBundles.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.renderer.json",
    "test": "vitest run",
    "start": "tsx src/cli/main.ts",
    "desktop": "npm run build:desktop && electron dist/desktop/main/main.js",
    "dist:desktop": "npm run build:desktop && electron-builder --win"
  },
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^24.19.1",
    "electron": "^44.7.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "openai": "^7.30.0"
  },
  "productName": "Texto em Fala",
  "author": "Jean Simas"
}
